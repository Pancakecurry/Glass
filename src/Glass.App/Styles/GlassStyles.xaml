<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="GlassFontFamily">Segoe UI Variable, Segoe UI</FontFamily>
    <SolidColorBrush x:Key="GlassTextPrimaryBrush" Color="{ThemeResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="GlassTextSecondaryBrush" Color="{ThemeResource TextFillColorSecondary}" />
    <SolidColorBrush x:Key="GlassDividerBrush" Color="{ThemeResource DividerStrokeColorDefault}" />
    <Style x:Key="GlassTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlassFontFamily}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource GlassTextPrimaryBrush}" />
    </Style>
    <Style x:Key="GlassSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlassFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource GlassTextPrimaryBrush}" />
    </Style>
    <Style x:Key="GlassCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlassFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource GlassTextSecondaryBrush}" />
    </Style>
    <Style x:Key="GlassIconButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style x:Key="GlassNavigationItemStyle" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
</ResourceDictionary>
