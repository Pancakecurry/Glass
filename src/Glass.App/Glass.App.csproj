<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Glass.App</RootNamespace>
    <AssemblyName>Glass.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>AnyCPU;x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <GlassPackageMode Condition="'$(GlassPackageMode)' == ''">Unpackaged</GlassPackageMode>
    <WindowsPackageType Condition="'$(GlassPackageMode)' != 'Packaged'">None</WindowsPackageType>
    <WindowsPackageType Condition="'$(GlassPackageMode)' == 'Packaged'">MSIX</WindowsPackageType>
    <EnableMsixTooling Condition="'$(GlassPackageMode)' == 'Packaged'">true</EnableMsixTooling>
    <WindowsAppSDKSelfContained Condition="'$(GlassPackageMode)' == 'Packaged' or '$(GlassPortableBuild)' == 'true'">true</WindowsAppSDKSelfContained>
    <SelfContained Condition="'$(GlassPackageMode)' == 'Packaged' or '$(GlassPortableBuild)' == 'true'">true</SelfContained>
    <RuntimeIdentifier Condition="'$(GlassPackageMode)' == 'Packaged' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(GlassPackageMode)' == 'Packaged' and '$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(GlassPackageMode)' == 'Packaged' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <GenerateAppxPackageOnBuild Condition="'$(GlassPackageMode)' == 'Packaged'">true</GenerateAppxPackageOnBuild>
    <AppxSymbolPackageEnabled Condition="'$(GlassPackageMode)' == 'Packaged'">false</AppxSymbolPackageEnabled>
    <AppxPackageSigningEnabled Condition="'$(AppxPackageSigningEnabled)' == ''">false</AppxPackageSigningEnabled>
    <AppxBundle Condition="'$(GlassPackageMode)' == 'Packaged'">Never</AppxBundle>
    <AppxPackageDir Condition="'$(GlassPackageMode)' == 'Packaged'">$(MSBuildProjectDirectory)\AppPackages\</AppxPackageDir>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <HoursBetweenUpdateChecks>8</HoursBetweenUpdateChecks>
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
    <AppxPackageVersion>$(GlassPackageVersion)</AppxPackageVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GlassPortableBuild)' == 'true'">
    <GlassPackageMode>Unpackaged</GlassPackageMode>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Glass.Core\Glass.Core.csproj" />
    <ProjectReference Include="..\Glass.Infrastructure\Glass.Infrastructure.csproj" />
    <ProjectReference Include="..\Glass.Platform.Windows\Glass.Platform.Windows.csproj" />
    <ProjectReference Include="..\Glass.Rendering\Glass.Rendering.csproj" />
    <ProjectReference Include="..\Glass.Shell\Glass.Shell.csproj" />
    <ProjectReference Include="..\Glass.Widgets.Abstractions\Glass.Widgets.Abstractions.csproj" />
    <ProjectReference Include="..\Glass.Widgets.BuiltIn\Glass.Widgets.BuiltIn.csproj" />
    <ProjectReference Include="..\Glass.Widgets.Runtime\Glass.Widgets.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Distribution\Glass.appinstaller.template" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Square44x44Logo.png" />
    <Content Include="Assets\Square150x150Logo.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\SmallTile.png" />
    <Content Include="Assets\LargeTile.png" />
    <Content Include="Assets\Wide310x150Logo.png" />
    <None Update="Assets\GlassMarkSource.png" />
  </ItemGroup>
</Project>
