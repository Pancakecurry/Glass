<Window
    x:Class="Glass.App.ProbeBarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="DragRegion" Grid.Column="0" Background="Transparent">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="Drag" />
        </Grid>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <Button
                x:Name="ProbeItemA"
                Content="A"
                Loaded="ProbeItem_Loaded"
                PointerEntered="ProbeItem_PointerEntered"
                PointerExited="ProbeItem_PointerExited" />
            <Button
                x:Name="ProbeItemB"
                Content="B"
                Loaded="ProbeItem_Loaded"
                PointerEntered="ProbeItem_PointerEntered"
                PointerExited="ProbeItem_PointerExited" />
            <Button
                x:Name="ProbeItemC"
                Content="C"
                Loaded="ProbeItem_Loaded"
                PointerEntered="ProbeItem_PointerEntered"
                PointerExited="ProbeItem_PointerExited" />
        </StackPanel>

        <TextBlock
            x:Name="MediaTitleText"
            Grid.Column="2"
            Margin="16,0"
            VerticalAlignment="Center"
            Text="No active media session"
            TextTrimming="CharacterEllipsis" />

        <TextBlock
            Grid.Column="3"
            Margin="12"
            VerticalAlignment="Center"
            Text="Probe" />
    </Grid>
</Window>
