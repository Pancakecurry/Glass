<Window
    x:Class="Glass.App.TechnicalSpikeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="20" Spacing="16">
            <TextBlock
                FontSize="20"
                FontWeight="SemiBold"
                Text="Technical spike / development UI — not product design" />

            <TextBlock Text="Surface" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Show probe bar" Click="ShowProbeBar_Click" />
                <Button Content="Hide probe bar" Click="HideProbeBar_Click" />
                <Button Content="Center on selected display" Click="CenterProbeBar_Click" />
            </StackPanel>
            <TextBlock x:Name="SurfaceStatusText" TextWrapping="Wrap" />

            <TextBlock Text="Display" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox
                    x:Name="DisplaySelector"
                    MinWidth="260"
                    SelectionChanged="DisplaySelector_SelectionChanged" />
                <Button Content="Refresh" Click="RefreshDisplays_Click" />
            </StackPanel>
            <TextBlock x:Name="DisplayStatusText" TextWrapping="Wrap" />

            <TextBlock Text="Docking" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="DockEdgeSelector" SelectedIndex="0" MinWidth="120">
                    <ComboBoxItem Content="Top" Tag="Top" />
                    <ComboBoxItem Content="Bottom" Tag="Bottom" />
                    <ComboBoxItem Content="Left" Tag="Left" />
                    <ComboBoxItem Content="Right" Tag="Right" />
                </ComboBox>
                <Button Content="Dock" Click="DockProbeBar_Click" />
                <Button Content="Undock" Click="UndockProbeBar_Click" />
            </StackPanel>
            <TextBlock x:Name="DockingStatusText" TextWrapping="Wrap" />

            <TextBlock Text="Composition" FontWeight="SemiBold" />
            <Button
                HorizontalAlignment="Left"
                Content="Trigger compositor animation"
                Click="TriggerAnimation_Click" />
            <TextBlock Text="Microsoft.UI.Composition spring scale; no XAML Storyboard." />

            <TextBlock Text="Media" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Previous" Click="Previous_Click" />
                <Button Content="Play / pause" Click="PlayPause_Click" />
                <Button Content="Next" Click="Next_Click" />
            </StackPanel>
            <TextBlock x:Name="MediaStatusText" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Window>
