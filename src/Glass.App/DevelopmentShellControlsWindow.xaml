<Window
    x:Class="Glass.App.DevelopmentShellControlsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="20" Spacing="12">
            <TextBlock FontSize="20" FontWeight="SemiBold"
                       Text="Development Shell Controls — not final product design" />
            <TextBlock Text="Bars" FontWeight="SemiBold" />
            <ListBox x:Name="BarList" MinHeight="110"
                     SelectionChanged="BarList_SelectionChanged" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Create" Click="Create_Click" />
                <Button Content="Remove" Click="Remove_Click" />
                <Button Content="Show" Click="Show_Click" />
                <Button Content="Hide" Click="Hide_Click" />
                <Button Content="Reset" Click="Reset_Click" />
            </StackPanel>

            <TextBlock Text="Target and placement" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="DisplaySelector" MinWidth="220" />
                <ComboBox x:Name="PlacementSelector" SelectedIndex="1" MinWidth="120">
                    <ComboBoxItem Content="Floating" Tag="Floating" />
                    <ComboBoxItem Content="Anchored" Tag="Anchored" />
                    <ComboBoxItem Content="Docked" Tag="Docked" />
                </ComboBox>
                <ComboBox x:Name="EdgeSelector" SelectedIndex="1" MinWidth="100">
                    <ComboBoxItem Content="Top" Tag="Top" />
                    <ComboBoxItem Content="Bottom" Tag="Bottom" />
                    <ComboBoxItem Content="Left" Tag="Left" />
                    <ComboBoxItem Content="Right" Tag="Right" />
                </ComboBox>
            </StackPanel>

            <TextBlock Text="Geometry and behavior" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="OrientationSelector" SelectedIndex="0" MinWidth="120">
                    <ComboBoxItem Content="Horizontal" Tag="Horizontal" />
                    <ComboBoxItem Content="Vertical" Tag="Vertical" />
                </ComboBox>
                <ComboBox x:Name="LengthModeSelector" SelectedIndex="0" MinWidth="120">
                    <ComboBoxItem Content="Fit content" Tag="FitContent" />
                    <ComboBoxItem Content="Fixed" Tag="Fixed" />
                    <ComboBoxItem Content="Fill" Tag="Fill" />
                </ComboBox>
                <TextBox x:Name="LengthBox" Header="Length (DIP)" Text="640" Width="110" />
                <TextBox x:Name="ThicknessBox" Header="Thickness (DIP)" Text="48" Width="110" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="16">
                <ToggleSwitch x:Name="AutoHideToggle" Header="Auto-hide" />
                <ToggleSwitch x:Name="AlwaysOnTopToggle" Header="Always on top" IsOn="True" />
                <ToggleSwitch x:Name="EnabledToggle" Header="Enabled" IsOn="True" />
                <Button Content="Apply" Click="Apply_Click" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock Text="Diagnostics" FontWeight="SemiBold" />
            <TextBlock x:Name="DiagnosticsText" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Window>
