<Window
    x:Class="Glass.App.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Padding="12" Background="#E0202020">
        <StackPanel Spacing="6">
            <Border x:Name="DragRegion" Background="Transparent" Padding="2">
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" />
            </Border>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
