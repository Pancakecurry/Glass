{
  "tokenSchemaVersion": 1,
  "status": "provisional",
  "description": "Semantic design-token foundation. Values are restrained starting defaults, not final visual direction.",
  "categories": {
    "structural": {
      "spacing": {
        "xs": { "value": 4, "unit": "px", "description": "Tight inline separation." },
        "sm": { "value": 8, "unit": "px", "description": "Related control separation." },
        "md": { "value": 12, "unit": "px", "description": "Default component padding." },
        "lg": { "value": 16, "unit": "px", "description": "Section and surface separation." },
        "xl": { "value": 24, "unit": "px", "description": "Major grouping separation." }
      },
      "cornerRadius": {
        "control": { "value": 8, "unit": "px", "description": "Default compact control radius." },
        "surface": { "value": 12, "unit": "px", "description": "Default floating surface radius." },
        "largeSurface": { "value": 18, "unit": "px", "description": "Large surface radius." }
      },
      "typography": {
        "caption": { "fontSize": 12, "lineHeight": 16, "weight": 400 },
        "body": { "fontSize": 14, "lineHeight": 20, "weight": 400 },
        "bodyStrong": { "fontSize": 14, "lineHeight": 20, "weight": 600 },
        "title": { "fontSize": 20, "lineHeight": 28, "weight": 600 }
      },
      "opacity": {
        "disabled": { "value": 0.45 },
        "secondaryContent": { "value": 0.72 },
        "subtleSurface": { "value": 0.84 }
      },
      "elevation": {
        "none": { "zIndex": 0, "shadow": "none" },
        "surface": { "zIndex": 10, "shadow": "restrained" },
        "overlay": { "zIndex": 20, "shadow": "stronger" }
      },
      "motion": {
        "duration": {
          "instant": { "value": 0, "unit": "ms" },
          "quick": { "value": 120, "unit": "ms" },
          "standard": { "value": 180, "unit": "ms" },
          "extended": { "value": 260, "unit": "ms" }
        },
        "easing": {
          "standard": { "kind": "cubicBezier", "value": [0.2, 0, 0, 1] },
          "emphasized": { "kind": "cubicBezier", "value": [0.2, 0, 0, 1] },
          "spring": {
            "kind": "semantic",
            "stiffness": "moderate",
            "damping": "high",
            "description": "Reserved for attached interaction, not decorative bounce."
          }
        }
      },
      "interaction": {
        "minimumTarget": { "value": 32, "unit": "px" },
        "preferredTarget": { "value": 40, "unit": "px" },
        "focusIndicatorThickness": { "value": 2, "unit": "px" }
      },
      "zLayer": {
        "desktop": { "value": 0 },
        "surface": { "value": 10 },
        "control": { "value": 20 },
        "popover": { "value": 30 },
        "systemOverlay": { "value": 40 }
      }
    },
    "materialDefaults": {
      "description": "User-customizable material inputs with safe starting values.",
      "userCustomizable": true,
      "translucency": { "value": 0.84, "range": [0, 1] },
      "luminosity": { "value": 0.96, "range": [0, 1] },
      "tintStrength": { "value": 0.08, "range": [0, 1] },
      "edgeHighlightStrength": { "value": 0.12, "range": [0, 1] },
      "shadowStrength": { "value": 0.16, "range": [0, 1] },
      "environmentalResponse": { "value": 0.2, "range": [0, 1] },
      "qualityTier": { "value": "normal", "allowed": ["high", "normal", "restricted"] }
    },
    "themeDefaults": {
      "description": "Provisional semantic theme values. Final themes belong to a later design phase.",
      "source": "provisional",
      "light": {
        "contentPrimary": "#1A1A1A",
        "contentSecondary": "#5C5C5C",
        "surfaceTint": "#FFFFFF",
        "accent": "#356AE6"
      },
      "dark": {
        "contentPrimary": "#F5F5F5",
        "contentSecondary": "#B9B9B9",
        "surfaceTint": "#181818",
        "accent": "#82A5FF"
      }
    }
  },
  "constraints": [
    {
      "id": "targets.minimum",
      "rule": "Interactive targets must not be smaller than structural.interaction.minimumTarget unless a platform convention or accessibility review explicitly permits it."
    },
    {
      "id": "motion.reduced",
      "rule": "Every motion behavior must define a reduced-motion outcome, including an immediate or materially shortened state transition."
    },
    {
      "id": "material.degrade",
      "rule": "Material settings must have a restricted-quality fallback that remains legible and usable without expensive effects."
    },
    {
      "id": "theme.semantic",
      "rule": "Feature code consumes semantic roles rather than hard-coded theme colors."
    },
    {
      "id": "z-order.semantic",
      "rule": "Surfaces use named z-layer semantics; arbitrary feature-local z-index values are avoided."
    }
  ]
}
