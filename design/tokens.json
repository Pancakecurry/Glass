{
  "tokenSchemaVersion": 2,
  "status": "phase-3",
  "description": "Semantic defaults and safe customization constraints for native Glass surfaces.",
  "fontFamily": "Segoe UI Variable, Segoe UI",
  "spacing": { "2xs": 2, "xs": 4, "sm": 6, "md": 8, "lg": 12, "xl": 16, "2xl": 24, "3xl": 32 },
  "radius": { "compact": 8, "control": 10, "widget": 16, "bar": 20, "controlCenter": 20, "maximum": 40 },
  "typography": {
    "caption": { "size": 12, "lineHeight": 16, "weight": 400 },
    "body": { "size": 14, "lineHeight": 20, "weight": 400 },
    "bodyStrong": { "size": 14, "lineHeight": 20, "weight": 600 },
    "subtitle": { "size": 16, "lineHeight": 22, "weight": 600 },
    "title": { "size": 20, "lineHeight": 28, "weight": 600 },
    "display": { "size": 32, "lineHeight": 38, "weight": 600 }
  },
  "targets": { "minimum": 32, "preferred": 40, "touchPreferred": 44, "focusStroke": 2 },
  "bar": { "defaultHeight": 52, "defaultIconSize": 32, "defaultPadding": 8, "defaultItemSpacing": 6 },
  "material": {
    "defaultPreset": "clear",
    "presets": ["clear", "frost", "smoke", "crystal", "solid"],
    "intensity": { "default": 0.72, "minimum": 0, "maximum": 1 },
    "tintStrength": { "default": 0.10, "minimum": 0, "maximum": 1 },
    "luminosity": { "default": 0.92, "minimum": 0, "maximum": 1 },
    "borderStrength": { "default": 0.20, "minimum": 0, "maximum": 1 },
    "edgeHighlightStrength": { "default": 0.28, "minimum": 0, "maximum": 1 },
    "shadowStrength": { "default": 0.24, "minimum": 0, "maximum": 1 },
    "overallOpacity": { "default": 1, "minimum": 0.45, "maximum": 1 }
  },
  "motion": {
    "hoverMs": 120,
    "pressMs": 75,
    "appearMs": 180,
    "flyoutMs": 150,
    "snapMs": 190,
    "autoHideMs": 220,
    "surfaceLiftMs": 160,
    "standardBezier": [0.2, 0, 0, 1],
    "pressScale": 0.96,
    "editScale": 1.015,
    "magnification": { "off": 1, "subtle": 1.14, "expressive": 1.28, "maximum": 1.35 }
  },
  "zLayer": { "desktop": 0, "surface": 10, "control": 20, "flyout": 30, "systemOverlay": 40 },
  "semanticRules": [
    "Feature code consumes semantic resources instead of local colors and timings.",
    "One backdrop treatment is used per top-level surface; nested blur is prohibited.",
    "High Contrast uses a solid legible treatment.",
    "Reduced motion removes magnification and spring overshoot.",
    "Global appearance flows into sparse surface and widget overrides.",
    "User customization is normalized to safe ranges and never overrides legibility requirements."
  ]
}
